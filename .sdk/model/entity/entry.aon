                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "translation"
                orig: "translation"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          method: "GET"
          orig: "/entries/{language}/{word}"
          segments: [
            {
              lit: "entries"
            }
            {
              var: "language"
            }
            {
              var: "word"
            }
          ]
          select: {
            exist: [
              "language"
              "pretty"
              "translation"
              "word"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
