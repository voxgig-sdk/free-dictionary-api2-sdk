# Entity: entry

main: kit: entity: entry: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    from: {
      word: "word"
    }
    name: "id"
    parts: [
      "language"
      "word"
    ]
    sep: "/"
  }

  name: "entry"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "language"
                orig: "language"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "word"
                orig: "word"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "pretty"
                orig: "pretty"
